/* Terminal-wide // structure: typography, geometry, layout margins.
 *
 * Colour lives in style_<scheme>.qss, which Mixxx appends after this file, so
 * everything here is deliberately colour-free. Sizes are picked for an 8.8"
 * 1920x480 panel viewed at arm's length: nothing readable is under 14px, and
 * nothing touchable is under 40px tall.
 */

/************** font *********************************************************/

#Mixxx,
WWidget,
WLabel,
WNumber, WNumberPos, WNumberRate,
WPushButton,
WKey,
WTime,
WTrackProperty,
WRateRange,
WSearchLineEdit,
WCueMenuPopup,
WCueMenuPopup QLabel,
WCueMenuPopup QLineEdit,
WOverview,
WTrackTableView,
WLibrarySidebar,
WLibraryTextBrowser,
WTrackTableViewHeader,
WTrackTableViewHeader::section,
WEffectSelector,
WEffectSelector QAbstractScrollArea,
WEffectSelector QAbstractItemView,
WEffectChainPresetSelector,
WEffectChainPresetSelector QAbstractScrollArea,
WEffectChainPresetSelector QAbstractItemView,
WEffectChainPresetButton,
WEffectChainPresetButton QMenu,
QMenu,
QToolTip {
  font-family: "Cascadia Mono", "Consolas", "DejaVu Sans Mono", "Menlo", monospace;
  font-weight: normal;
  font-style: normal;
  text-transform: none;
}

/************** toolbar ******************************************************/

#ToolBar {
  padding: 2px 4px;
}

#TabControls WPushButton,
#ToolBarOptions WPushButton {
  font-size: 20px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 0px 2px;
}

#ClockTime {
  font-size: 20px;
  margin-left: 6px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

/************** deck column **************************************************/

#DeckPanelLeft {
  margin: 2px 3px 2px 2px;
  padding: 2px 6px;
}

#DeckPanelRight {
  margin: 2px 2px 2px 3px;
  padding: 2px 6px;
}

#DeckHeader {
  margin-bottom: 2px;
}

#DeckLabel {
  font-size: 20px;
  font-weight: bold;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

/* Field captions. One size, one case, everywhere - btop's own hierarchy is
   dim lowercase caption over bright value. */
#DeckFieldLabel {
  font-size: 15px;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignBottom';
}

#DeckTitle {
  font-size: 28px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

/* The position readout, and by a wide margin the largest thing on the panel:
   with the platter doing the playing, how long is left is the number the
   operator is actually looking for.

   Eight monospace cells - "-4:06.64" - sharing the row with the bpm box, which
   is a fixed 176 now that its caption sits beside the number. Forty leaves the
   eight cells at ~192 against the ~200 the row has left. */
#DeckTime {
  font-size: 40px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

/* The bpm block. Reverse video, and the only thing on the deck that gets it -
   see the colour layer. */
#DeckBpmBox {
  margin-left: 8px;
  padding: 0px 8px;
}

#DeckBpmCaption {
  font-size: 15px;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

/* Mirrors the bpm box above it. */
#DeckRateBox {
  margin-left: 8px;
}

#DeckBpm {
  font-size: 38px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

/* Rate, sign and range are one reading - "0.00 +-8" - so the number ends
   where the sign begins and the range follows it, and the group lands near the
   middle of the box without any of the three being centred in its own span.
   The range is the smaller of the two: it changes when you change the pitch
   *window*, not when you move the platter. */
#DeckRate {
  font-size: 25px;
  qproperty-alignment: 'AlignRight | AlignVCenter';
}

#DeckRateSign {
  font-size: 15px;
  qproperty-alignment: 'AlignCenter';
}

#DeckRateRange {
  font-size: 15px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

/* Left, under the time, which is also left. This needs the wkey patch on the
   terminal-skin branch: upstream WKey paints its own text with a hard-coded
   Qt::AlignCenter whenever key colours are on, and ignores both <Alignment>
   and the stylesheet. Without the patch the key reads centred instead - wrong
   but harmless. */
#DeckKey {
  font-size: 25px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

/************** deck buttons *************************************************/

/* 42px tall, 1px apart. About 9mm on this panel, which is the width of a
   fingertip - the whole reason the deck column is 430px wide. */
#DeckTransport WPushButton,
#DvsControlsRow WPushButton {
  font-size: 20px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 1px;
  padding: 0px;
}

#DeckTransport,
#DvsControls {
  margin-top: 4px;
}

/************** deck rows: hot cues, loop, beatjump **************************/

#DeckHotcueRow,
#DeckLoopJumpRow {
  margin-top: 3px;
}

/* The gaps in this row come from the fillers either side of each half, not
   from a margin: the halves show and hide independently, and a margin on one
   of them leaves the row lopsided whenever the other is hidden. */

#DeckHotcueRow WPushButton,
#DeckLoopJumpRow WPushButton {
  font-size: 20px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 1px;
  padding: 0px;
}

/* The loop glyph, a size up from the row's lettering: a single mark at the
   same 20px as a word reads lighter than the word does. */
#LoopActivate {
  font-size: 26px;
}

/* The length readouts. Their steppers are sized away rather than merely
   unstyled: the length is a readout, and a stepper would be one more thing to
   press on a row that is meant to have almost nothing. */
#LoopSize, #JumpSize {
  font-size: 20px;
  font-weight: bold;
  margin: 1px;
  padding: 0px 4px;
  qproperty-alignment: 'AlignCenter';
}

#LoopSize::up-button, #LoopSize::down-button,
#JumpSize::up-button, #JumpSize::down-button,
#LoopSize::up-arrow, #LoopSize::down-arrow,
#JumpSize::up-arrow, #JumpSize::down-arrow {
  width: 0px;
  height: 0px;
  border: none;
}

#DvsStatusLight {
  font-size: 17px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 0px;
}

/************** fx page ******************************************************/

#FxUnitPanel {
  margin: 4px;
  padding: 4px 8px;
}

#FxUnitLabel {
  font-size: 23px;
  font-weight: bold;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#FxRouteLabel {
  font-size: 16px;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#FxUnitHeader WPushButton,
#FxSlotEnable {
  font-size: 20px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 1px;
  padding: 0px;
}

/* The selector is the interaction the page exists for, so it and its drop-down
   list get a finger's height rather than the ~20px rows a combo box uses on a
   desktop. */
#FxSelector {
  font-size: 20px;
  margin: 1px 4px;
  padding: 0px 8px;
}

#FxSelector QAbstractItemView::item {
  min-height: 42px;
}

/* Chain presets. The selector reads like the effect selectors beside it; the
   menu button is a block with a glyph, and its menu gets the same finger-sized
   rows the drop-downs do. */
#FxPresetSelector {
  font-size: 18px;
  margin: 1px 4px;
  padding: 0px 8px;
}

#FxPresetSelector QAbstractItemView::item {
  min-height: 42px;
}

#FxPresetButton {
  font-size: 20px;
  font-weight: bold;
  margin: 1px;
  padding: 0px;
}

/* The button carries no text of its own - the widget has no <Text> - so the
   menu indicator is the glyph, and it belongs in the middle of the block
   rather than tucked in a corner. */
#FxPresetButton::menu-indicator {
  subcontrol-origin: margin;
  subcontrol-position: center center;
}

/* The preset menu is the one list here that grows without limit - every saved
   preset is a row, on top of the fixed items - so its rows are tighter than the
   skin's other menus. At 18px text and 8px padding a row is ~40px, still a
   finger, and ten of them fit the panel before Qt has to scroll the menu. */
#FxPresetButton QMenu::item {
  padding: 8px 16px;
}

#FxKnobLabel {
  font-size: 15px;
  text-transform: lowercase;
  qproperty-alignment: 'AlignHCenter | AlignTop';
}

#FxSlotRow {
  margin-top: 4px;
}

#FxSlotParams WPushButton {
  font-size: 17px;
  font-weight: bold;
  margin: 1px;
  padding: 0px;
}

#FxKnobBox, #FxButtonBox {
  margin: 0px 1px;
}

/************** waveforms ****************************************************/

#WaveformColumn {
  margin: 2px 0px;
}

#WaveformBox1,
#WaveformBox2 {
  margin: 1px 0px;
}

/* In column mode the two lanes sit side by side, so the gap between them has
   to be horizontal instead. */
#WaveformCols #WaveformBox1,
#WaveformCols #WaveformBox2 {
  margin: 0px 1px;
}

#OverviewRow {
  margin-top: 2px;
}

#OverviewBox1, #OverviewFrame1 {
  margin-right: 1px;
}

#OverviewBox2, #OverviewFrame2 {
  margin-left: 1px;
}

#OverviewFullRow {
  margin: 2px 2px 0px 2px;
}

#OverviewFullBox1, #OverviewFullBox1 #OverviewFrame1 {
  margin-right: 1px;
}

#OverviewFullBox2, #OverviewFullBox2 #OverviewFrame2 {
  margin-left: 1px;
}

/* In the deck column there is no sibling to keep a gap from. */
#DeckOverviewBox {
  margin-top: 4px;
}

#DeckOverviewBox #OverviewFrame1,
#DeckOverviewBox #OverviewFrame2 {
  margin: 0px;
}

/************** library ******************************************************/

#LibraryPage {
  margin: 2px;
}

#SearchRow {
  margin-bottom: 2px;
}

WSearchLineEdit {
  font-size: 23px;
  padding: 4px 6px;
}

WLibrarySidebar {
  font-size: 20px;
}

WTrackTableView {
  font-size: 20px;
}

WTrackTableViewHeader::section {
  font-size: 16px;
  text-transform: lowercase;
  padding: 2px 4px;
}

/* Wider than the default: a scrollbar is also a drag target here. */
#LibraryContainer QScrollBar:vertical {
  width: 14px;
}

#LibraryContainer QScrollBar:horizontal {
  height: 14px;
}

/************** menus, popups, tooltips **************************************/

/* These had no size of their own and were left at Qt's default, which is a
   desktop's default and far too small here. The track context menu in
   particular is the one place the skin hands you a list to hit with a finger. */
QMenu, QMenu::item,
WTrackMenu, WTrackMenu QMenu,
WCueMenuPopup, WCueMenuPopup QLabel, WCueMenuPopup QLineEdit,
WLibrarySidebar QMenu,
WTrackTableViewHeader QMenu,
WSearchLineEdit QMenu,
QToolTip {
  font-size: 18px;
}

QMenu::item {
  padding: 10px 18px;
}

/************** options page *************************************************/

#OptionsPage {
  margin: 8px 12px;
}

#OptionsColumn {
  margin-right: 24px;
}

#OptionsSection {
  font-size: 17px;
  font-weight: bold;
  text-transform: lowercase;
  margin-bottom: 4px;
  qproperty-alignment: 'AlignLeft | AlignBottom';
}

#OptionRow {
  margin: 1px 0px;
}

#OptionCaption {
  font-size: 20px;
  text-transform: lowercase;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}

#OptionRow WPushButton {
  font-size: 20px;
  font-weight: bold;
  text-transform: lowercase;
  margin: 1px;
  padding: 0px;
}

#OptionsNote {
  font-size: 15px;
  text-transform: lowercase;
  margin-top: 6px;
  qproperty-alignment: 'AlignLeft | AlignVCenter';
}
